
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#121214">
    <meta name="description" content="Professional music recording, production, and Virtual DAW Progressive Web App">
    <title>Music Recording App</title>
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎵</text></svg>">
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎵</text></svg>">

    <!-- CSS stylesheet link -->
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <!-- Main Studio Dashboard Container -->
    <div id="app-container" class="studio-wrapper">

        <!-- Top Header Navigation & Status -->
        <header class="studio-header">
            <div class="brand">
                <span class="logo-icon">🎧</span>
                <h1>Music Recording App</h1>
            </div>
            <div class="header-actions">
                <span id="audio-status" class="status-badge status-disconnected">Engine Offline</span>
                <button id="install-btn" class="btn btn-secondary hidden" aria-label="Install App">Install App</button>
            </div>
        </header>

        <!-- Main Workspace Area -->
        <main class="studio-main">

            <!-- Section 1: Microphone Voice Recording & Master Audio Playback Control -->
            <section class="panel recording-panel" id="voice-recording-section">
                <div class="panel-header">
                    <h2>Voice & Audio Recorder</h2>
                    <span id="recording-timer" class="timer-display">00:00:00</span>
                </div>
                <div class="panel-body grid-recorder">
                    
                    <!-- Recording Controls -->
                    <div class="recorder-controls">
                        <button id="start-rec-btn" class="btn btn-danger">🔴 Record</button>
                        <button id="pause-rec-btn" class="btn btn-warning" disabled>⏸️ Pause</button>
                        <button id="stop-rec-btn" class="btn btn-square" disabled>⬛ Stop</button>
                    </div>

                    <!-- Visualizer Canvas -->
                    <div class="visualizer-container">
                        <canvas id="audio-visualizer" width="600" height="100"></canvas>
                    </div>

                    <!-- Output & Playback Controls -->
                    <div class="playback-controls">
                        <audio id="audio-preview" controls class="audio-player"></audio>
                        <div class="download-actions">
                            <a id="download-rec-btn" class="btn btn-success disabled-link" download="studio-recording.wav">⬇️ Download Recording</a>
                        </div>
                    </div>

                </div>
            </section>

            <!-- Section 2: Virtual Piano Keyboard -->
            <section class="panel piano-panel" id="piano-section">
                <div class="panel-header">
                    <h2>Virtual Piano Keyboard</h2>
                    <div class="octave-controls">
                        <label for="piano-octave">Octave:</label>
                        <select id="piano-octave" class="select-input">
                            <option value="3">Low (C3)</option>
                            <option value="4" selected>Standard (C4)</option>
                            <option value="5">High (C5)</option>
                        </select>
                    </div>
                </div>
                <div class="panel-body">
                    <!-- Piano Keys Wrapper -->
                    <div id="piano-keyboard" class="piano-keyboard-container">
                        <!-- White Keys -->
                        <div class="piano-key key-white" data-note="C" data-key="a"><span class="key-label">C (A)</span></div>
                        <div class="piano-key key-black" data-note="C#" data-key="w"><span class="key-label">C# (W)</span></div>
                        <div class="piano-key key-white" data-note="D" data-key="s"><span class="key-label">D (S)</span></div>
                        <div class="piano-key key-black" data-note="D#" data-key="e"><span class="key-label">D# (E)</span></div>
                        <div class="piano-key key-white" data-note="E" data-key="d"><span class="key-label">E (D)</span></div>
                        <div class="piano-key key-white" data-note="F" data-key="f"><span class="key-label">F (F)</span></div>
                        <div class="piano-key key-black" data-note="F#" data-key="t"><span class="key-label">F# (T)</span></div>
                        <div class="piano-key key-white" data-note="G" data-key="g"><span class="key-label">G (G)</span></div>
                        <div class="piano-key key-black" data-note="G#" data-key="y"><span class="key-label">G# (Y)</span></div>
                        <div class="piano-key key-white" data-note="A" data-key="h"><span class="key-label">A (H)</span></div>
                        <div class="piano-key key-black" data-note="A#" data-key="u"><span class="key-label">A# (U)</span></div>
                        <div class="piano-key key-white" data-note="B" data-key="j"><span class="key-label">B (J)</span></div>
                        <div class="piano-key key-white" data-note="C2" data-key="k"><span class="key-label">C (K)</span></div>
                    </div>
                </div>
            </section>

            <!-- Section 3: Virtual Drum Pads -->
            <section class="panel drum-panel" id="drums-section">
                <div class="panel-header">
                    <h2>Virtual Drum Pads</h2>
                    <span class="panel-subtitle">Tap or use keys [1-8]</span>
                </div>
                <div class="panel-body">
                    <div id="drum-pads-grid" class="pads-grid">
                        <button class="drum-pad" data-sound="kick" data-key="1">
                            <span class="pad-name">Kick</span>
                            <span class="pad-shortcut">[1]</span>
                        </button>
                        <button class="drum-pad" data-sound="snare" data-key="2">
                            <span class="pad-name">Snare</span>
                            <span class="pad-shortcut">[2]</span>
                        </button>
                        <button class="drum-pad" data-sound="hihat-closed" data-key="3">
                            <span class="pad-name">Hi-Hat Closed</span>
                            <span class="pad-shortcut">[3]</span>
                        </button>
                        <button class="drum-pad" data-sound="hihat-open" data-key="4">
                            <span class="pad-name">Hi-Hat Open</span>
                            <span class="pad-shortcut">[4]</span>
                        </button>
                        <button class="drum-pad" data-sound="tom-low" data-key="5">
                            <span class="pad-name">Low Tom</span>
                            <span class="pad-shortcut">[5]</span>
                        </button>
                        <button class="drum-pad" data-sound="tom-mid" data-key="6">
                            <span class="pad-name">Mid Tom</span>
                            <span class="pad-shortcut">[6]</span>
                        </button>
                        <button class="drum-pad" data-sound="crash" data-key="7">
                            <span class="pad-name">Crash</span>
                            <span class="pad-shortcut">[7]</span>
                        </button>
                        <button class="drum-pad" data-sound="clap" data-key="8">
                            <span class="pad-name">Clap</span>
                            <span class="pad-shortcut">[8]</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Section 4: Drum Beat Sequencer -->
            <section class="panel sequencer-panel" id="sequencer-section">
                <div class="panel-header">
                    <h2>Drum Beat Sequencer</h2>
                    <div class="sequencer-transport">
                        <button id="seq-play-btn" class="btn btn-primary">▶️ Play Loop</button>
                        <button id="seq-stop-btn" class="btn btn-square">⬛ Stop</button>
                        <button id="seq-clear-btn" class="btn btn-outline">🗑️ Clear Pattern</button>
                        <div class="tempo-control">
                            <label for="seq-bpm">BPM:</label>
                            <input type="number" id="seq-bpm" min="40" max="240" value="120" class="number-input">
                        </div>
                    </div>
                </div>
                <div class="panel-body scrollable-x">
                    <div id="sequencer-grid" class="sequencer-grid">
                        <!-- Sequencer Rows for Instruments -->
                        
                        <!-- Kick Track -->
                        <div class="seq-track" data-track="kick">
                            <span class="track-label">Kick</span>
                            <div class="steps-container" data-instrument="kick">
                                <button class="seq-step" data-step="0"></button>
                                <button class="seq-step" data-step="1"></button>
                                <button class="seq-step" data-step="2"></button>
                                <button class="seq-step" data-step="3"></button>
                                <button class="seq-step" data-step="4"></button>
                                <button class="seq-step" data-step="5"></button>
                                <button class="seq-step" data-step="6"></button>
                                <button class="seq-step" data-step="7"></button>
                                <button class="seq-step" data-step="8"></button>
                                <button class="seq-step" data-step="9"></button>
                                <button class="seq-step" data-step="10"></button>
                                <button class="seq-step" data-step="11"></button>
                                <button class="seq-step" data-step="12"></button>
                                <button class="seq-step" data-step="13"></button>
                                <button class="seq-step" data-step="14"></button>
                                <button class="seq-step" data-step="15"></button>
                            </div>
                        </div>

                        <!-- Snare Track -->
                        <div class="seq-track" data-track="snare">
                            <span class="track-label">Snare</span>
                            <div class="steps-container" data-instrument="snare">
                                <button class="seq-step" data-step="0"></button>
                                <button class="seq-step" data-step="1"></button>
                                <button class="seq-step" data-step="2"></button>
                                <button class="seq-step" data-step="3"></button>
                                <button class="seq-step" data-step="4"></button>
                                <button class="seq-step" data-step="5"></button>
                                <button class="seq-step" data-step="6"></button>
                                <button class="seq-step" data-step="7"></button>
                                <button class="seq-step" data-step="8"></button>
                                <button class="seq-step" data-step="9"></button>
                                <button class="seq-step" data-step="10"></button>
                                <button class="seq-step" data-step="11"></button>
                                <button class="seq-step" data-step="12"></button>
                                <button class="seq-step" data-step="13"></button>
                                <button class="seq-step" data-step="14"></button>
                                <button class="seq-step" data-step="15"></button>
                            </div>
                        </div>

                        <!-- Closed Hi-Hat Track -->
                        <div class="seq-track" data-track="hihat-closed">
                            <span class="track-label">Hi-Hat (C)</span>
                            <div class="steps-container" data-instrument="hihat-closed">
                                <button class="seq-step" data-step="0"></button>
                                <button class="seq-step" data-step="1"></button>
                                <button class="seq-step" data-step="2"></button>
                                <button class="seq-step" data-step="3"></button>
                                <button class="seq-step" data-step="4"></button>
                                <button class="seq-step" data-step="5"></button>
                                <button class="seq-step" data-step="6"></button>
                                <button class="seq-step" data-step="7"></button>
                                <button class="seq-step" data-step="8"></button>
                                <button class="seq-step" data-step="9"></button>
                                <button class="seq-step" data-step="10"></button>
                                <button class="seq-step" data-step="11"></button>
                                <button class="seq-step" data-step="12"></button>
                                <button class="seq-step" data-step="13"></button>
                                <button class="seq-step" data-step="14"></button>
                                <button class="seq-step" data-step="15"></button>
                            </div>
                        </div>

                        <!-- Open Hi-Hat Track -->
                        <div class="seq-track" data-track="hihat-open">
                            <span class="track-label">Hi-Hat (O)</span>
                            <div class="steps-container" data-instrument="hihat-open">
                                <button class="seq-step" data-step="0"></button>
                                <button class="seq-step" data-step="1"></button>
                                <button class="seq-step" data-step="2"></button>
                                <button class="seq-step" data-step="3"></button>
                                <button class="seq-step" data-step="4"></button>
                                <button class="seq-step" data-step="5"></button>
                                <button class="seq-step" data-step="6"></button>
                                <button class="seq-step" data-step="7"></button>
                                <button class="seq-step" data-step="8"></button>
                                <button class="seq-step" data-step="9"></button>
                                <button class="seq-step" data-step="10"></button>
                                <button class="seq-step" data-step="11"></button>
                                <button class="seq-step" data-step="12"></button>
                                <button class="seq-step" data-step="13"></button>
                                <button class="seq-step" data-step="14"></button>
                                <button class="seq-step" data-step="15"></button>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

        </main>

        <!-- Studio Footer -->
        <footer class="studio-footer">
            <p>Music Recording App &copy; 2026 | Built with Web Audio API & PWA Support</p>
        </footer>

    </div>

    <!-- Application Logic Link -->
    <script src="app.js"></script>
</body>
</html>
